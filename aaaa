//----------- Vertex shader

attribute vec3 vPosition;
attribute vec2 vTexCoord;
varying vec2 texCoord;

uniform mat4 ProjectionModelViewMatrix;

void main()
{
	gl_Position = ProjectionModelViewMatrix * vec4(vPosition.xyz, 1.0);
	texCoord = vTexCoord;
}

